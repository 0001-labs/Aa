{
  "name": "@0001-labs/aa",
  "version": "0.2.0",
  "description": "Aa, the text editor of 0001's products: Markdown, drawn as you write",
  "type": "module",
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "src/aa.css",
    "src/fonts/",
    "convex/",
    "README.md"
  ],
  "main": "./dist/aa.js",
  "module": "./dist/aa.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/aa.js"
    },
    "./aa.css": "./src/aa.css",
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./collaboration": {
      "types": "./dist/collaboration.d.ts",
      "import": "./dist/collaboration.js"
    },
    "./convex": {
      "types": "./dist/convex.d.ts",
      "import": "./dist/convex.js"
    },
    "./convex.config": {
      "types": "./convex/convex.config.ts",
      "import": "./convex/convex.config.ts"
    }
  },
  "sideEffects": [
    "./src/element.ts",
    "./src/aa.css",
    "./dist/aa.js"
  ],
  "scripts": {
    "dev": "vp dev",
    "build": "vp exec tsc -p tsconfig.build.json && vp build --config vite.config.lib.ts && vp build --config vite.config.react.ts && vp build --config vite.config.collaboration.ts && vp build --config vite.config.convex.ts",
    "check": "vp exec tsc --noEmit",
    "test": "vp test",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.13.1",
    "@types/react": "19.2.10",
    "@types/react-dom": "^19.3.0",
    "convex": "^1.46.0",
    "convex-test": "^0.0.61",
    "happy-dom": "^20.14.0",
    "katex": "^0.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "convex": ">=1.30",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "convex": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "yjs": "^13.6.33"
  }
}
