{
  "name": "@0001-labs/aa",
  "version": "0.10.0",
  "description": "Aa, the text editor of 0001's products: Markdown, drawn as you write",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0001-labs/Aa.git"
  },
  "homepage": "https://aa.0001.dev",
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "src/aa.css",
    "src/ds1/",
    "src/fonts/",
    "convex/",
    "README.md",
    "bin/aa.mjs"
  ],
  "main": "./dist/aa.js",
  "module": "./dist/aa.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/aa.js"
    },
    "./aa.css": "./src/aa.css",
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./collaboration": {
      "types": "./dist/collaboration.d.ts",
      "import": "./dist/collaboration.js"
    },
    "./diagram": {
      "types": "./dist/diagram.d.ts",
      "import": "./dist/diagram.js"
    },
    "./diagram-language": {
      "types": "./dist/diagram-language.d.ts",
      "import": "./dist/diagram-language.js"
    },
    "./marker": {
      "types": "./dist/marker.d.ts",
      "import": "./dist/marker.js"
    },
    "./convex": {
      "types": "./dist/convex.d.ts",
      "import": "./dist/convex.js"
    },
    "./convex.config": {
      "types": "./convex/convex.config.ts",
      "import": "./convex/convex.config.ts"
    },
    "./partial-reader": {
      "types": "./dist/partial-reader.d.ts",
      "import": "./dist/partial-reader.js"
    },
    "./comments-markdown": {
      "types": "./dist/comments-markdown.d.ts",
      "import": "./dist/comments-markdown.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "import": "./dist/parse.js"
    }
  },
  "sideEffects": [
    "./src/element.ts",
    "./src/aa.css",
    "./src/ds1/0-face/grid.ts",
    "./src/ds1/0-face/constraint-panel.ts",
    "./dist/aa.js",
    "./src/vendor/ds1/**/*.ts"
  ],
  "scripts": {
    "dev": "vp dev",
    "docs:dev": "cd website && vp exec astro dev",
    "site:build": "cd website && vp exec astro build && cd .. && rm -rf site && cp -R website/dist site",
    "deploy": "sync1 guard && vp run site:build && CLOUDFLARE_ACCOUNT_ID=ce6189d5ac975158991e207a3c4e1cd5 vp exec wrangler deploy",
    "build": "vp exec tsc -p tsconfig.build.json && vp build --config vite.config.lib.ts && vp build --config vite.config.react.ts && vp build --config vite.config.collaboration.ts && vp build --config vite.config.convex.ts && vp build --config vite.config.diagram.ts && vp build --config vite.config.diagram-language.ts && vp build --config vite.config.marker.ts && vp build --config vite.config.partial-reader.ts && vp build --config vite.config.comments.ts && vp build --config vite.config.parse.ts",
    "check": "sync1 check && vp exec tsc --noEmit",
    "test": "vp test",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.13.1",
    "@types/react": "19.2.10",
    "@types/react-dom": "^19.3.0",
    "convex": "^1.46.0",
    "convex-test": "^0.0.61",
    "happy-dom": "^20.14.0",
    "katex": "^0.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.151.1"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "convex": ">=1.30",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "convex": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "yaml": "^2.9.1",
    "yjs": "^13.6.33"
  },
  "bin": {
    "aa": "bin/aa.mjs"
  }
}
