---
import { version } from '../../../package.json';
---
<header class="ds-header ds-header--app docs-header">
  <a class="ds-header__brand" href="/">Aa <span class="docs-version">{version}</span></a>
  <nav class="ds-header__actions" aria-label="Elsewhere">
    <a href="/start-here/overview/">Documentation</a>
    <a href="https://designsystem1.com">Design system 1</a>
    <a href="https://github.com/0001-labs/Aa">GitHub</a>
  </nav>
</header>
<style>
  .docs-header { flex: none; grid-template-columns: minmax(0, 1fr) auto; }
  .docs-header nav { grid-column: 2; }
  .docs-header a { color: inherit; text-decoration: none; }
  .docs-header a:hover { text-decoration: underline; }
  .docs-version { display: inline-block; color: var(--ds-text-color-muted, color-mix(in srgb, currentColor 55%, transparent)); }
  @media (max-width: 599px) { .docs-header nav { display: none; } }
</style>
