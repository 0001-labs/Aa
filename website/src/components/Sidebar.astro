---
// The features down the left, as Design system 1's documentation lists its parts: each group a
// square below the last under its name in the muted ink, its pages one a line, the page you are
// on filled.
const { sidebar } = Astro.locals.starlightRoute;
type Entry = { type: 'link' | 'group'; label: string; href?: string; isCurrent?: boolean; entries?: Entry[] };
---

<nav class="docs-rail" aria-label="Documentation">
  {(sidebar as Entry[]).map(entry => entry.type === 'group'
    ? <section class="rail-group">
        <p class="rail-name">{entry.label}</p>
        <ul>{entry.entries!.map(page => <li><a href={page.href} aria-current={page.isCurrent ? 'page' : undefined}>{page.label}</a></li>)}</ul>
      </section>
    : <section class="rail-group"><ul><li><a href={entry.href} aria-current={entry.isCurrent ? 'page' : undefined}>{entry.label}</a></li></ul></section>)}
  <section class="rail-group rail-foot">
    <p class="rail-name">From 0001</p>
    <ul><li><a href="https://designsystem1.com">Design system 1</a></li></ul>
  </section>
</nav>

<style>
  .docs-rail { display: flex; flex-direction: column; gap: var(--grid); padding: var(--grid); font-size: var(--docs-type); line-height: var(--grid); }
  .rail-group ul { margin: 0; padding: 0; list-style: none; }
  .rail-name { margin: 0; color: var(--ds-text-color-muted); }
  .rail-group a { display: block; width: fit-content; max-width: 100%; margin-inline-start: calc(-4px * var(--sf, 1)); padding: 0 calc(4px * var(--sf, 1)); border-radius: calc(2px * var(--sf, 1)); color: var(--ds-text-color); text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rail-group a:hover { background: var(--ds-fill); }
  .rail-group a[aria-current='page'] { background: var(--ds-fill-hover); }
  .rail-group a:focus-visible { outline: 2px solid var(--ds-focus-ring); outline-offset: 1px; }
</style>
