---
// The features down the left on Design system 1's rail, as its documentation lists its parts:
// eight squares wide, each group a square below the last under its name in the muted ink, its
// pages one square a line with the words on the lower sixteen, the page you are on outlined, and
// a foot of two squares for the source (Design system 1 is in the header).
const { sidebar } = Astro.locals.starlightRoute;
type Entry = { type: 'link' | 'group'; label: string; href?: string; isCurrent?: boolean; entries?: Entry[] };
type Row = { name: string; href?: string; current?: boolean; gap: boolean };
const rows: Row[] = (sidebar as Entry[]).flatMap((entry, index) => entry.type === 'group'
  ? [{ name: entry.label, gap: index > 0 }, ...entry.entries!.map(page => ({ name: page.label, href: page.href, current: page.isCurrent, gap: false }))]
  : [{ name: entry.label, href: entry.href, current: entry.isCurrent, gap: index > 0 }]);
---

<nav class="docs-rail" aria-label="Documentation">
  <div class="rail-links">
    {rows.map(row => row.href
      ? <a class:list={['rail-entry', { 'rail-gap': row.gap }]} href={row.href} aria-current={row.current ? 'page' : undefined}>{row.name}</a>
      : <p class:list={['rail-group', { 'rail-gap': row.gap }]}>{row.name}</p>)}
  </div>
  <footer class="rail-footer">
    <a class="rail-entry" href="https://github.com/0001-labs/Aa">GitHub</a>
  </footer>
</nav>

<style>
  .docs-rail { display: flex; flex-direction: column; box-sizing: border-box; width: calc(8 * var(--grid)); height: 100%; padding: var(--grid) calc(var(--grid) / 2) var(--grid) var(--grid); font-size: var(--docs-type); }
  .rail-links { display: flex; flex-direction: column; flex: 1; min-height: 0; overflow-y: auto; scrollbar-width: none; }
  .rail-links::-webkit-scrollbar { display: none; }
  .rail-gap { margin-top: var(--grid); }
  /* One square a line, the words on its lower sixteen. */
  .rail-group, .rail-entry { flex: none; display: flex; align-items: flex-end; height: var(--grid); margin-block-end: 0; line-height: calc(16px * var(--sf, 1)); white-space: nowrap; }
  .rail-group { margin-inline: 0; padding: 0; color: var(--ds-text-color-muted); }
  .rail-entry { align-self: flex-start; max-width: 100%; margin-inline-start: calc(-4px * var(--sf, 1)); padding: 0 calc(4px * var(--sf, 1)); border-radius: calc(2px * var(--sf, 1)); color: var(--ds-text-color); text-decoration: none; overflow: hidden; text-overflow: ellipsis; }
  .rail-entry:hover { background: var(--ds-fill); }
  .rail-entry[aria-current='page'] { outline: 1px solid var(--ds-sharp-blue, var(--sharp-blue)); outline-offset: 1px; }
  .rail-entry:focus-visible { outline: 2px solid var(--ds-focus-ring); outline-offset: 1px; }
  .rail-footer { display: flex; align-items: flex-end; justify-content: space-between; flex: none; height: calc(2 * var(--grid)); box-shadow: inset 0 1px var(--ds1-docs-divider); }
  .rail-footer .rail-entry { margin-inline-start: 0; }
</style>
